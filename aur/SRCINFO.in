pkgbase = avernella-bin
	pkgdesc = Native Linux client for LINE, packaged from the Avernella Ubuntu release
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/novesce/avernella
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = sdl2-compat
	depends = cairo
	depends = pango
	depends = glib2
	depends = qrencode
	depends = curl
	depends = @CRYPTO@
	depends = @VPX@
	depends = libjpeg-turbo
	depends = libpng
	depends = libwebp
	depends = opus
	depends = libsrtp
	depends = libpipewire
	depends = zlib
	depends = wayland
	depends = gtk4
	depends = webkitgtk-6.0
	optdepends = ffmpeg: video playback and recording
	optdepends = vulkan-icd-loader: native GPU rendering with a Vulkan driver
	optdepends = xdg-desktop-portal: file chooser, screenshots and screen sharing
	optdepends = zbar: scanning QR images
@WPE@
	provides = avernella=@VERSION@
	conflicts = avernella
	noextract = @DEB@
	options = !strip
	options = !debug
	source = https://github.com/novesce/avernella-packaging/releases/download/avernella-@SHA@/@DEB@
	sha256sums = @SUM@

pkgname = avernella-bin
