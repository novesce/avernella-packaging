id: io.github.novesce.Avernella
runtime: org.gnome.Platform
runtime-version: '49'
sdk: org.gnome.Sdk
command: avernella
finish-args:
  - --share=ipc
  - --share=network
  - --socket=fallback-x11
  - --socket=wayland
  - --socket=pulseaudio
  - --device=all
  - --talk-name=org.freedesktop.Notifications
  - --talk-name=org.kde.StatusNotifierWatcher
  - --talk-name=org.freedesktop.StatusNotifierWatcher
  - --own-name=io.github.novesce.Avernella.StatusNotifierItem
  - --talk-name=org.freedesktop.portal.Desktop
  - --filesystem=xdg-download
  - --filesystem=xdg-pictures:ro
  - --filesystem=xdg-videos:ro
  - --filesystem=xdg-documents:ro
cleanup:
  - /include
  - /lib/pkgconfig
  - /lib/cmake
  - /share/aclocal
  - /share/doc
  - /share/man
  - '*.la'
  - '*.a'
modules:
  - name: libsrtp
    buildsystem: meson
    config-opts:
      - -Dcrypto-library=openssl
      - -Dtests=disabled
      - -Dpcap-tests=disabled
      - -Ddoc=disabled
    sources:
      - type: archive
        url: https://github.com/cisco/libsrtp/archive/refs/tags/v2.8.1.tar.gz
        sha256: ef5569220749529d778013aae1178391d972570a2b4f7288dda22effa875b07c

  - name: zbar
    buildsystem: simple
    build-commands:
      - autoreconf -fi
      - >-
        ./configure --prefix=/app --libdir=/app/lib
        --enable-shared --disable-static --disable-video --disable-doc
        --without-x --without-xv --without-xshm --without-gtk --without-gir
        --without-qt --without-qt6 --without-python --without-java
        --without-imagemagick --without-graphicsmagick --without-dbus
        --without-npapi --without-jpeg
      - make -j"${FLATPAK_BUILDER_N_JOBS}"
      - make install
      - install -Dm644 LICENSE.md /app/share/licenses/zbar/LICENSE.md
    sources:
      - type: archive
        url: https://github.com/mchehab/zbar/archive/refs/tags/0.23.93.tar.gz
        sha256: 212dfab527894b8bcbcc7cd1d43d63f5604a07473d31a5f02889e372614ebe28

  - name: libqrencode
    buildsystem: simple
    build-commands:
      - autoreconf -fi
      - ./configure --prefix=/app --libdir=/app/lib --enable-shared --disable-static --without-tools
      - make -j"${FLATPAK_BUILDER_N_JOBS}"
      - make install
      - install -Dm644 COPYING /app/share/licenses/libqrencode/COPYING
    sources:
      - type: archive
        url: https://github.com/fukuchi/libqrencode/archive/refs/tags/v4.1.1.tar.gz
        sha256: 5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c

  # Avernella itself is the verified Ubuntu release, as in the AUR and COPR
  # packages. The GNOME runtime provides its libraries except qrencode
  # (built above) and libvpx.so.12: the runtime has libvpx.so.11, so Ubuntu
  # 26.04's libvpx12, which the release links against, goes in /app/lib.
  - name: avernella
    buildsystem: simple
    build-options:
      no-debuginfo: true
      strip: false
    build-commands:
      - mkdir deb vpx
      - bsdtar -xf @DEB@ 'data.tar.*'
      - bsdtar --no-same-owner -xf data.tar.* -C deb
      - rm data.tar.*
      - bsdtar -xf libvpx12_1.16.0-3_amd64.deb 'data.tar.*'
      - bsdtar --no-same-owner -xf data.tar.* -C vpx
      - install -Dm755 deb/usr/bin/avernella /app/bin/avernella
      - install -Dm755 deb/usr/lib/avernella/avernella-liff-gtk /app/lib/avernella/avernella-liff-gtk
      - install -Dm644 deb/usr/lib/avernella/avernella-vulkan.so /app/lib/avernella/avernella-vulkan.so
      - install -Dm644 vpx/usr/lib/x86_64-linux-gnu/libvpx.so.12.0.0 /app/lib/libvpx.so.12
      - install -Dm644 io.github.novesce.Avernella.desktop /app/share/applications/io.github.novesce.Avernella.desktop
      - install -Dm644 io.github.novesce.Avernella.metainfo.xml /app/share/metainfo/io.github.novesce.Avernella.metainfo.xml
      - install -Dm644 deb/usr/share/icons/hicolor/256x256/apps/avernella.png /app/share/icons/hicolor/256x256/apps/io.github.novesce.Avernella.png
      - install -Dm644 deb/usr/share/icons/hicolor/64x64/apps/avernella.png /app/share/icons/hicolor/64x64/apps/io.github.novesce.Avernella.png
      - install -d /app/share/licenses/avernella
      - cp -a deb/usr/share/doc/avernella/. /app/share/licenses/avernella/
      - install -Dm644 vpx/usr/share/doc/libvpx12/copyright /app/share/licenses/libvpx/copyright
    sources:
      - type: file
        url: https://github.com/novesce/avernella-packaging/releases/download/avernella-@COMMIT@/@DEB@
        sha256: @SUM@
      - type: file
        url: https://launchpad.net/ubuntu/+archive/primary/+files/libvpx12_1.16.0-3_amd64.deb
        sha256: e1b852dfaa099fbcc60ab08d4e340553a7701c501544089609838c9417ba5fa0
      - type: file
        path: io.github.novesce.Avernella.desktop
      - type: file
        path: io.github.novesce.Avernella.metainfo.xml
