+/* The high byte of a native Cairo RGB24 pixel is unspecified. */
+static void check_visible_pixels(int offset, const uint32_t *reference)
+{
+	int left = W, top = H, right = -1, bottom = -1;
+	guint changed = 0, padding = 0;
+	uint32_t first = 0, expected = 0;
+
+	for (int y = 0; y < H; y++) {
+		for (int x = 0; x < W; x++) {
+			uint32_t actual = presented[y][x];
+			uint32_t wanted = reference[y * W + x];
+
+			if (actual == wanted)
+				continue;
+			if (!((actual ^ wanted) & 0x00ffffff)) {
+				padding++;
+				continue;
+			}
+			if (!changed) {
+				first = actual;
+				expected = wanted;
+			}
+			changed++;
+			left = MIN(left, x);
+			top = MIN(top, y);
+			right = MAX(right, x);
+			bottom = MAX(bottom, y);
+		}
+	}
+	if (changed || padding)
+		g_test_message("Offset %d: %u RGB differences in (%d,%d)-(%d,%d), "
+			       "first actual %#08x expected %#08x, %u padding-only differences",
+			       offset, changed, left, top, right, bottom, first,
+			       expected, padding);
+	g_assert_cmpuint(changed, ==, 0);
+}
